---
import { BUSINESS_NAME, EMAIL, PHONE_DISPLAY, PHONE_E164 } from '../lib/config/contact';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="brand">{BUSINESS_NAME}</p>
      <p class="meta">Custom cakes for birthdays, weddings and everything worth celebrating.</p>
    </div>

    <nav aria-label="Footer">
      <a href="/#gallery">Cakes</a>
      <a href="/#how-it-works">How it works</a>
      <a href="/#about">About</a>
      <a href="/order">Order a cake</a>
    </nav>

    <div class="footer-contact">
      <a href={`tel:${PHONE_E164}`}>{PHONE_DISPLAY}</a>
      <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
    </div>
  </div>
  <div class="container footer-base">
    <p>&copy; {year} {BUSINESS_NAME}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-deep);
    color: var(--text-inverse);
    padding-block: var(--space-8) calc(var(--space-6) + 4rem);
  }

  .footer-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1.4fr 1fr 1fr;
  }

  .brand {
    margin: 0;
    font-family: var(--font-brand);
    font-size: 3rem;
    line-height: 1;
    color: var(--accent-highlight);
  }

  .meta {
    margin: var(--space-3) 0 0;
    max-width: 32ch;
    color: var(--text-inverse-muted);
  }

  nav,
  .footer-contact {
    display: grid;
    align-content: start;
    gap: var(--space-2);
  }

  .site-footer a {
    width: fit-content;
    text-decoration: none;
    color: var(--text-inverse-soft);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .site-footer a:hover,
  .site-footer a:focus-visible {
    color: var(--text-inverse);
    text-decoration: underline;
  }

  .footer-base {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid oklch(96.5% 0.014 78 / 0.16);
    color: var(--text-inverse-muted);
    font-size: 0.9rem;
  }

  .footer-base p {
    margin: 0;
  }

  @media (max-width: 52rem) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
