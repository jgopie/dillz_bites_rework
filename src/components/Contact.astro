---
import WhatsAppIcon from './WhatsAppIcon.astro';
import { EMAIL, HOURS, PHONE_DISPLAY, PHONE_E164, buildWhatsAppHref } from '../lib/config/contact';

const whatsappHref = buildWhatsAppHref();
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="container contact-grid">
    <div data-reveal>
      <p class="eyebrow">Contact</p>
      <h2 class="section-title" id="contact-title">
        What are we <span class="script-accent">celebrating?</span>
      </h2>
      <p class="section-intro">
        WhatsApp is the quickest way to check a date, get a quote and send inspiration photos. Prefer to talk?
        Call or email and we'll get back to you.
      </p>
      <a href={whatsappHref} class="button-cream contact-cta" target="_blank" rel="noopener noreferrer">
        <WhatsAppIcon />
        Chat on WhatsApp
      </a>
    </div>

    <div class="contact-details" data-reveal>
      <dl>
        <div>
          <dt>Phone</dt>
          <dd><a href={`tel:${PHONE_E164}`}>{PHONE_DISPLAY}</a></dd>
        </div>
        <div>
          <dt>Email</dt>
          <dd><a href={`mailto:${EMAIL}`}>{EMAIL}</a></dd>
        </div>
        <div>
          <dt>Hours</dt>
          <dd>
            <ul class="hours">
              {
                HOURS.map((row) => (
                  <li>
                    <span>{row.days}</span>
                    <span>{row.time}</span>
                  </li>
                ))
              }
            </ul>
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .contact {
    position: relative;
    background:
      radial-gradient(ellipse 50% 80% at 10% 100%, oklch(55% 0.17 12 / 0.85), transparent 70%),
      var(--accent-primary);
    color: var(--text-inverse);
    padding-block: clamp(6rem, 11vw, 9rem) clamp(5rem, 9vw, 7rem);
    overflow: clip;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }

  .contact .eyebrow {
    color: var(--accent-highlight);
  }

  .contact .section-title {
    color: var(--text-inverse);
    font-size: clamp(3rem, 8vw, 7rem);
    line-height: 0.92;
    max-width: 9ch;
  }

  .contact .script-accent {
    color: var(--accent-highlight);
  }

  .contact .section-intro {
    color: var(--text-inverse-soft);
    max-width: 44ch;
  }

  .contact-cta {
    margin-top: var(--space-6);
  }

  .contact :global(:focus-visible) {
    outline-color: var(--bg-canvas);
  }

  .contact-details {
    rotate: 2deg;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: var(--bg-surface);
    color: var(--text-strong);
    border-radius: var(--radius-md);
    box-shadow: 0 2rem 3rem oklch(22% 0.08 10 / 0.35);
  }

  dl {
    margin: 0;
    display: grid;
    gap: var(--space-5);
  }

  dl > div + div {
    padding-top: var(--space-5);
    border-top: 2px dashed var(--border-soft);
  }

  dt {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--accent-secondary-text);
  }

  dd {
    margin: var(--space-1) 0 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
    overflow-wrap: anywhere;
  }

  dd a {
    color: var(--text-strong);
  }

  .hours {
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-body);
    font-size: 1rem;
    display: grid;
    gap: var(--space-1);
  }

  .hours li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .hours li span:last-child {
    color: var(--text-muted);
  }

  @media (max-width: 52rem) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .contact-details {
      rotate: 0deg;
    }
  }

  @media (max-width: 30rem) {
    .hours li {
      flex-direction: column;
      gap: 0;
    }

    .hours li + li {
      margin-top: var(--space-2);
    }
  }
</style>
