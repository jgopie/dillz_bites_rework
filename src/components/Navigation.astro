---
import { BUSINESS_NAME } from '../lib/config/contact';

interface Props {
  currentPath?: '/' | '/order';
}

const { currentPath = '/' } = Astro.props;
const links = [
  { href: '/#gallery', label: 'Cakes' },
  { href: '/#how-it-works', label: 'How it works' },
  { href: '/#about', label: 'About' },
  { href: '/#contact', label: 'Contact' }
];
---

<header class="site-header">
  <div class="container nav-row">
    <a class="brand" href="/" aria-label={`${BUSINESS_NAME} home`}>{BUSINESS_NAME}</a>
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label="Open navigation menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
    <nav id="primary-nav" class="nav-links" aria-label="Primary">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
      <a
        href="/order"
        class="nav-order"
        aria-current={currentPath === '/order' ? 'page' : undefined}
      >
        Order a cake
      </a>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector('.menu-toggle');
  const menu = document.querySelector('.nav-links');

  if (button instanceof HTMLButtonElement && menu instanceof HTMLElement) {
    button.addEventListener('click', () => {
      const expanded = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!expanded));
      menu.dataset.open = expanded ? 'false' : 'true';
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        button.setAttribute('aria-expanded', 'false');
        menu.dataset.open = 'false';
      });
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: var(--surface-frost);
    border-bottom: 1px solid var(--border-soft);
  }

  .nav-row {
    position: relative;
    min-height: 4.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .brand {
    font-family: var(--font-brand);
    font-size: 2.35rem;
    line-height: 1;
    color: var(--accent-primary);
    text-decoration: none;
    padding-top: 0.2rem;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .nav-links a {
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.5rem 0.75rem;
    color: var(--text-muted);
    transition: color var(--transition-fast);
  }

  .nav-links a:hover,
  .nav-links a:focus-visible {
    color: var(--text-strong);
  }

  .nav-links .nav-order {
    margin-left: var(--space-3);
    padding: 0.55rem 1.1rem;
    border-radius: var(--radius-pill);
    background: var(--accent-primary);
    color: var(--text-inverse);
  }

  .nav-links .nav-order:hover,
  .nav-links .nav-order:focus-visible,
  .nav-links .nav-order[aria-current='page'] {
    background: var(--accent-primary-strong);
    color: var(--text-inverse);
  }

  .menu-toggle {
    display: none;
    border: 1px solid var(--border-soft);
    background: var(--bg-surface);
    border-radius: var(--radius-sm);
    padding: 0.6rem;
    cursor: pointer;
  }

  .menu-toggle span {
    display: block;
    width: 1.2rem;
    height: 0.125rem;
    border-radius: var(--radius-pill);
    background-color: var(--text-strong);
  }

  .menu-toggle span + span {
    margin-top: 0.25rem;
  }

  @media (max-width: 52rem) {
    .menu-toggle {
      display: block;
    }

    .nav-links {
      position: absolute;
      top: calc(100% + 0.5rem);
      right: 0;
      left: 0;
      padding: var(--space-3);
      background: var(--bg-surface);
      border: 1px solid var(--border-soft);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-md);
      flex-direction: column;
      align-items: stretch;
      opacity: 0;
      pointer-events: none;
      transform: translateY(-6px);
      transition: opacity var(--transition-fast), transform var(--transition-fast);
    }

    .nav-links[data-open='true'] {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }

    .nav-links a {
      padding: 0.75rem;
    }

    .nav-links .nav-order {
      margin: var(--space-2) 0 0;
      text-align: center;
    }
  }
</style>
