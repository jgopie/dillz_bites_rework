---
import { Image } from 'astro:assets';
import bridalCake from '../assets/images/cake_4.jpg';
import roseCake from '../assets/images/cake_1.jpg';
import footballCake from '../assets/images/cake_8.jpg';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { buildWhatsAppHref } from '../lib/config/contact';

const whatsappHref = buildWhatsAppHref();

const cards = [
  {
    src: footballCake,
    alt: 'Royal blue Chelsea FC drip cake with footballs and a gold Happy Birthday topper',
    note: 'Big match birthday',
    className: 'card-left'
  },
  {
    src: roseCake,
    alt: 'Number one cake piped with peach and cream rosettes and gold pearls',
    note: 'All the rosettes',
    className: 'card-right'
  },
  {
    src: bridalCake,
    alt: 'Two-tier bridal shower cake with an illustrated couple and pink buttercream ruffles',
    note: 'So it begins...',
    className: 'card-center'
  }
];
---

<section class="hero scallop-bottom" id="home">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow hero-eyebrow">Custom cakes, made to order</p>
      <h1>
        <span class="line"><span>Cakes that</span></span>
        <span class="line"><span>look like</span></span>
        <span class="line"><span>the <em class="script-accent">party</em></span></span>
        <span class="line"><span>feels.</span></span>
      </h1>
      <p class="lede">
        Birthdays, bridal showers, weddings and every milestone in between. Tell us the theme, the colours and
        the crowd; we'll design, bake and finish a cake that's yours alone.
      </p>
      <div class="hero-actions">
        <a href={whatsappHref} class="button-cream" target="_blank" rel="noopener noreferrer">
          <WhatsAppIcon />
          Start your order
        </a>
        <a href="#gallery" class="hero-link">See the cakes &darr;</a>
      </div>
    </div>

    <div class="hero-fan">
      {
        cards.map((card, index) => (
          <figure class={`snap ${card.className}`}>
            <Image
              src={card.src}
              alt={card.alt}
              widths={[320, 480, 720]}
              sizes="(max-width: 52rem) 45vw, 22rem"
              loading="eager"
              fetchpriority={index === 2 ? 'high' : undefined}
            />
            <figcaption>{card.note}</figcaption>
          </figure>
        ))
      }

      <svg class="badge" viewBox="0 0 200 200" aria-hidden="true">
        <defs>
          <path id="badge-circle" d="M100,100 m-72,0 a72,72 0 1,1 144,0 a72,72 0 1,1 -144,0" />
        </defs>
        <circle cx="100" cy="100" r="98" class="badge-bg" />
        <text class="badge-text">
          <textPath href="#badge-circle" textLength="452">MADE TO ORDER &#183; BAKED FRESH &#183;</textPath>
        </text>
        <text x="100" y="118" text-anchor="middle" class="badge-mark">D</text>
      </svg>
    </div>
  </div>
</section>

<style>
  .hero {
    --scallop-color: var(--accent-primary);
    position: relative;
    background:
      radial-gradient(ellipse 60% 70% at 85% 40%, oklch(55% 0.17 12 / 0.9), transparent 70%),
      var(--accent-primary);
    color: var(--text-inverse);
    padding-block: clamp(3rem, 7vw, 6rem) clamp(4.5rem, 9vw, 7.5rem);
    overflow-x: clip;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }

  .hero-eyebrow {
    color: var(--accent-highlight);
  }

  h1 {
    margin: 0;
    font-size: clamp(3.4rem, 8vw, 7.4rem);
    line-height: 0.92;
    letter-spacing: -0.03em;
    color: var(--text-inverse);
  }

  .line {
    display: block;
    overflow: clip;
    padding-bottom: 0.06em;
  }

  .line > span {
    display: inline-block;
    animation: rise 900ms var(--ease-out) both;
  }

  .line:nth-child(2) > span {
    animation-delay: 80ms;
  }

  .line:nth-child(3) > span {
    animation-delay: 160ms;
  }

  .line:nth-child(4) > span {
    animation-delay: 240ms;
  }

  h1 .script-accent {
    font-style: normal;
    color: var(--accent-highlight);
    font-size: 1.12em;
    line-height: 0.8;
    padding-inline: 0.04em;
  }

  .lede {
    margin: var(--space-6) 0 0;
    max-width: 42ch;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    color: var(--text-inverse-soft);
    animation: fade 900ms 380ms var(--ease-out) both;
  }

  .hero-actions {
    margin-top: var(--space-6);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
    animation: fade 900ms 460ms var(--ease-out) both;
  }

  .hero-link {
    color: var(--text-inverse);
    font-weight: 700;
    text-decoration-color: currentColor !important;
  }

  .hero :global(:focus-visible) {
    outline-color: var(--bg-canvas);
  }

  /* Fan of framed snapshots. */
  .hero-fan {
    position: relative;
    aspect-ratio: 1 / 1.08;
    width: min(100%, 37rem);
    justify-self: end;
  }

  .snap {
    position: absolute;
    margin: 0;
    width: 58%;
    padding: 0.7rem 0.7rem 0;
    background: var(--bg-surface);
    border-radius: 0.4rem;
    box-shadow: 0 1.6rem 3rem oklch(22% 0.08 10 / 0.42);
    /* backwards (not both) so hover transitions still apply after the entrance. */
    animation: deal 1100ms var(--ease-out) backwards;
    transition: transform 500ms var(--ease-out);
  }

  .snap img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 0.2rem;
  }

  .snap figcaption {
    font-family: var(--font-brand);
    font-size: clamp(1.3rem, 2vw, 1.75rem);
    line-height: 1;
    color: var(--text-strong);
    text-align: center;
    padding: 0.55rem 0 0.75rem;
  }

  .card-left {
    left: 0;
    top: 10%;
    --r: -11deg;
    transform: rotate(var(--r));
    animation-delay: 260ms;
  }

  .card-right {
    right: 0;
    top: 4%;
    --r: 9deg;
    transform: rotate(var(--r));
    animation-delay: 380ms;
  }

  .card-center {
    left: 21%;
    top: 20%;
    width: 62%;
    --r: -2deg;
    transform: rotate(var(--r));
    animation-delay: 500ms;
    z-index: 2;
  }

  .hero-fan:hover .card-left {
    transform: rotate(-15deg) translate(-6%, -2%);
  }

  .hero-fan:hover .card-right {
    transform: rotate(13deg) translate(6%, -2%);
  }

  .hero-fan:hover .card-center {
    transform: rotate(0deg) translateY(-3%);
  }

  .badge {
    position: absolute;
    z-index: 3;
    width: clamp(6.5rem, 26%, 9rem);
    right: -2%;
    bottom: 4%;
    animation: spin 26s linear infinite;
    filter: drop-shadow(0 0.8rem 1.2rem oklch(22% 0.08 10 / 0.35));
  }

  .badge-bg {
    fill: var(--accent-highlight);
  }

  .badge-text {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 19px;
    letter-spacing: 0.08em;
    fill: var(--text-strong);
  }

  .badge-mark {
    font-family: var(--font-brand);
    font-size: 64px;
    fill: var(--accent-primary);
  }

  @keyframes rise {
    from {
      transform: translateY(105%);
    }
  }

  @keyframes fade {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @keyframes deal {
    from {
      opacity: 0;
      transform: translateY(40%) rotate(0deg) scale(0.9);
    }
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 52rem) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-fan {
      width: min(100%, 26rem);
      margin-top: var(--space-4);
    }
  }
</style>
