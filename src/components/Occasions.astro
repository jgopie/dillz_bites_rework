---
const occasions = [
  'Birthdays',
  'Bridal showers',
  'Weddings',
  'Baby showers',
  'Anniversaries',
  'Graduations',
  'Just because'
];
---

<section class="occasions" aria-label="Occasions we bake for">
  <ul class="container">
    {occasions.map((occasion) => <li>{occasion}</li>)}
  </ul>
</section>

<style>
  .occasions {
    background: var(--accent-primary);
    color: var(--text-inverse);
    padding-block: var(--space-5);
  }

  ul {
    margin: 0 auto;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-5);
  }

  li {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.2vw, 1.45rem);
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  li + li::before {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--accent-highlight);
  }

  @media (max-width: 44rem) {
    li + li::before {
      display: none;
    }
  }
</style>
