---
const occasions = [
  'Birthdays',
  'Bridal showers',
  'Weddings',
  'Baby showers',
  'Anniversaries',
  'Graduations',
  'Just because'
];
---

<section class="ribbon" aria-label="Occasions we bake for">
  <div class="track">
    <ul>
      {occasions.map((occasion) => <li>{occasion}</li>)}
    </ul>
    <ul aria-hidden="true">
      {occasions.map((occasion) => <li>{occasion}</li>)}
    </ul>
  </div>
</section>

<style>
  .ribbon {
    position: relative;
    z-index: 3;
    margin-block: calc(var(--space-6) * -1) var(--space-2);
    margin-inline: -2rem;
    padding-block: 1.1rem;
    background: var(--accent-highlight);
    color: var(--text-strong);
    transform: rotate(-2.2deg);
    box-shadow: 0 1rem 2rem oklch(27% 0.035 42 / 0.16);
    overflow: hidden;
  }

  .track {
    display: flex;
    width: max-content;
    animation: marquee 38s linear infinite;
  }

  .ribbon:hover .track {
    animation-play-state: paused;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex: none;
  }

  li {
    display: flex;
    align-items: center;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.8vw, 2.1rem);
    line-height: 1.1;
    white-space: nowrap;
  }

  li::after {
    content: '';
    width: 0.55em;
    height: 0.55em;
    margin-inline: 0.9em;
    background: var(--accent-primary);
    /* Four-point sparkle. */
    clip-path: polygon(50% 0, 62% 38%, 100% 50%, 62% 62%, 50% 100%, 38% 62%, 0 50%, 38% 38%);
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }
  }
</style>
