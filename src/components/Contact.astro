---
import WhatsAppIcon from './WhatsAppIcon.astro';
import { EMAIL, HOURS, PHONE_DISPLAY, PHONE_E164, buildWhatsAppHref } from '../lib/config/contact';

const whatsappHref = buildWhatsAppHref();
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="container contact-grid">
    <div data-reveal>
      <p class="eyebrow">Contact</p>
      <h2 class="section-title" id="contact-title">
        What are we <span class="script-accent">celebrating?</span>
      </h2>
      <p class="section-intro">
        WhatsApp is the quickest way to check a date, get a quote and send inspiration photos. Prefer to talk?
        Call or email and we'll get back to you.
      </p>
      <a href={whatsappHref} class="button-whatsapp contact-cta" target="_blank" rel="noopener noreferrer">
        <WhatsAppIcon />
        Chat on WhatsApp
      </a>
    </div>

    <div class="contact-details" data-reveal>
      <dl>
        <div>
          <dt>Phone</dt>
          <dd><a href={`tel:${PHONE_E164}`}>{PHONE_DISPLAY}</a></dd>
        </div>
        <div>
          <dt>Email</dt>
          <dd><a href={`mailto:${EMAIL}`}>{EMAIL}</a></dd>
        </div>
        <div>
          <dt>Hours</dt>
          <dd>
            <ul class="hours">
              {
                HOURS.map((row) => (
                  <li>
                    <span>{row.days}</span>
                    <span>{row.time}</span>
                  </li>
                ))
              }
            </ul>
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }

  .contact-cta {
    margin-top: var(--space-6);
  }

  .contact-details {
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: var(--bg-surface);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-lg);
  }

  dl {
    margin: 0;
    display: grid;
    gap: var(--space-5);
  }

  dl > div + div {
    padding-top: var(--space-5);
    border-top: 1px solid var(--border-soft);
  }

  dt {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--accent-secondary-text);
  }

  dd {
    margin: var(--space-1) 0 0;
    font-family: var(--font-display);
    font-size: 1.3rem;
    overflow-wrap: anywhere;
  }

  dd a {
    color: var(--text-strong);
  }

  .hours {
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-body);
    font-size: 1rem;
    display: grid;
    gap: var(--space-1);
  }

  .hours li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .hours li span:last-child {
    color: var(--text-muted);
  }

  @media (max-width: 52rem) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 30rem) {
    .hours li {
      flex-direction: column;
      gap: 0;
    }

    .hours li + li {
      margin-top: var(--space-2);
    }
  }
</style>
