---
import { Image } from 'astro:assets';
import bridalCake from '../assets/images/cake_4.jpg';
import chocolateCake from '../assets/images/cake_9.jpg';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { buildWhatsAppHref } from '../lib/config/contact';

const whatsappHref = buildWhatsAppHref();
---

<section class="hero" id="home">
  <div class="container hero-grid">
    <div class="hero-copy" data-reveal>
      <p class="eyebrow">Custom cakes, made to order</p>
      <h1>Cakes that look like the <span class="script-accent">party</span> feels.</h1>
      <p class="lede">
        Birthdays, bridal showers, weddings and every milestone in between. Tell us the theme, the colours and
        the crowd, and we'll design, bake and finish a cake that's yours alone.
      </p>
      <div class="hero-actions">
        <a href={whatsappHref} class="button" target="_blank" rel="noopener noreferrer">
          <WhatsAppIcon />
          Start your order
        </a>
        <a href="#gallery" class="button-outline">See recent cakes</a>
      </div>
    </div>

    <div class="hero-art" data-reveal>
      <div class="hero-arch">
        <Image
          src={bridalCake}
          alt="Two-tier bridal shower cake with an illustrated couple, pink buttercream ruffles and a So it begins topper"
          widths={[420, 640, 900]}
          sizes="(max-width: 52rem) 80vw, 34rem"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="hero-round">
        <Image
          src={chocolateCake}
          alt="Chocolate drip cake piled with doughnuts and chocolate bars"
          widths={[240, 400]}
          sizes="12rem"
          loading="eager"
        />
      </div>
      <p class="hero-sticker" aria-hidden="true">Every cake<br />made to order</p>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(4rem, 8vw, 6.5rem);
    overflow: clip;
  }

  .hero-grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
    grid-template-columns: 1.05fr 0.95fr;
  }

  .hero-copy h1 {
    margin: 0;
    font-size: clamp(2.8rem, 6.6vw, 5.4rem);
    line-height: 1.02;
    max-width: 12ch;
  }

  .hero-copy .script-accent {
    font-size: 1.25em;
    line-height: 0.8;
  }

  .lede {
    margin: var(--space-5) 0 0;
    max-width: 44ch;
    font-size: 1.15rem;
    color: var(--text-muted);
  }

  .hero-actions {
    margin-top: var(--space-6);
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .hero-art {
    position: relative;
    justify-self: center;
    width: min(100%, 30rem);
    padding: 0 0 3rem 3rem;
  }

  .hero-arch {
    border-radius: var(--radius-arch);
    overflow: clip;
    background: var(--accent-soft);
    box-shadow: var(--shadow-lg);
    outline: 1.5px solid var(--accent-secondary);
    outline-offset: 0.75rem;
  }

  .hero-arch img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  .hero-round {
    position: absolute;
    left: 0;
    bottom: 0;
    width: clamp(8rem, 30%, 11rem);
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: clip;
    border: 6px solid var(--bg-canvas);
    box-shadow: var(--shadow-md);
  }

  .hero-round img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }

  .hero-sticker {
    position: absolute;
    top: 8%;
    right: -0.5rem;
    margin: 0;
    width: 7.5rem;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    text-align: center;
    border-radius: 50%;
    background: var(--accent-primary);
    color: var(--text-inverse);
    font-family: var(--font-display);
    font-size: 0.95rem;
    line-height: 1.15;
    transform: rotate(10deg);
    box-shadow: var(--shadow-md);
  }

  @media (max-width: 52rem) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-art {
      width: min(100%, 24rem);
      padding: 0 0 2.5rem 2rem;
    }

    .hero-sticker {
      width: 6.25rem;
      font-size: 0.82rem;
      right: -0.25rem;
    }
  }
</style>
