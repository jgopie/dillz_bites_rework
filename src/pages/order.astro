---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import {
  EMAIL,
  ORDER_TEMPLATE_FIELDS,
  PHONE_DISPLAY,
  PHONE_E164,
  buildOrderTemplateMessage,
  buildWhatsAppHref
} from '../lib/config/contact';

const templateHref = buildWhatsAppHref(buildOrderTemplateMessage());
const blankHref = buildWhatsAppHref();
---

<BaseLayout
  title="Order a Custom Cake | Dillz Bites"
  description="Start your custom cake order with Dillz Bites on WhatsApp. Send your date, servings, theme and budget in one message."
  canonicalPath="/order"
>
  <Navigation currentPath="/order" />
  <main id="main-content" class="section order scallop-bottom">
    <div class="container order-grid">
      <div class="order-copy" data-reveal>
        <p class="eyebrow">Order a cake</p>
        <h1 class="section-title">Your cake starts with <span class="script-accent">one</span> message.</h1>
        <p class="section-intro">
          Tap the button and WhatsApp opens with our order template ready to fill in. Add what you know, leave
          blank what you don't, then send a few inspiration photos. We'll reply with ideas, pricing and
          availability.
        </p>

        <div class="order-actions">
          <a href={templateHref} class="button-cream" target="_blank" rel="noopener noreferrer">
            <WhatsAppIcon />
            Open the order template
          </a>
          <a href={blankHref} class="order-plain" target="_blank" rel="noopener noreferrer">
            Or just say hello
          </a>
        </div>

        <p class="order-alt">
          Not on WhatsApp? Call <a href={`tel:${PHONE_E164}`}>{PHONE_DISPLAY}</a> or email
          <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.
        </p>
      </div>

      <figure class="ticket" data-reveal aria-labelledby="ticket-title">
        <figcaption id="ticket-title" class="ticket-head">
          <span class="ticket-brand">Dillz Bites</span>
          <span class="ticket-label">Cake order</span>
        </figcaption>
        <ol class="ticket-fields">
          {
            ORDER_TEMPLATE_FIELDS.map((field) => (
              <li>
                <span>{field}</span>
              </li>
            ))
          }
        </ol>
        <p class="ticket-foot">+ inspiration photos</p>
      </figure>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .order {
    --scallop-color: var(--accent-primary);
    min-height: auto;
    padding-block: clamp(3.5rem, 8vw, 6rem) clamp(4.5rem, 9vw, 7rem);
    background:
      radial-gradient(ellipse 55% 70% at 90% 30%, oklch(55% 0.17 12 / 0.9), transparent 70%),
      var(--accent-primary);
    color: var(--text-inverse);
    overflow-x: clip;
  }

  .order :global(:focus-visible) {
    outline-color: var(--bg-canvas);
  }

  .order .eyebrow,
  .order-copy .script-accent {
    color: var(--accent-highlight);
  }

  .order-copy .section-title {
    color: var(--text-inverse);
  }

  .order-copy .section-intro {
    color: var(--text-inverse-soft);
  }

  .order-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: center;
  }

  .order-copy h1 {
    font-size: clamp(3rem, 7vw, 6rem);
    line-height: 0.95;
    max-width: 11ch;
  }

  .order-actions {
    margin-top: var(--space-6);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
  }

  .order-plain {
    font-weight: 700;
    color: var(--text-inverse);
    text-decoration-color: currentColor !important;
  }

  .order-alt {
    margin: var(--space-6) 0 0;
    color: var(--text-inverse-soft);
  }

  .order-alt a {
    color: var(--text-inverse);
    font-weight: 700;
    text-decoration-color: currentColor !important;
  }

  /* Paper order ticket with a scalloped bottom edge. */
  .ticket {
    position: relative;
    margin: 0;
    padding: var(--space-6) var(--space-6) var(--space-7);
    background: var(--bg-surface);
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    color: var(--text-strong);
    box-shadow: 0 2rem 3.5rem oklch(22% 0.08 10 / 0.4);
    rotate: 2.5deg;
    --scallop: radial-gradient(circle at 0.75rem 0, transparent 0.6rem, var(--bg-surface) 0.62rem);
  }

  .ticket::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.75rem;
    height: 0.75rem;
    background: var(--scallop);
    background-size: 1.5rem 0.75rem;
    transform: scaleY(-1);
  }

  .ticket-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 2px dashed var(--border-soft);
  }

  .ticket-brand {
    font-family: var(--font-brand);
    font-size: 2.2rem;
    line-height: 1;
    color: var(--accent-primary);
  }

  .ticket-label {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--accent-secondary-text);
  }

  .ticket-fields {
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
    counter-reset: field;
  }

  .ticket-fields li {
    counter-increment: field;
    display: flex;
    align-items: flex-end;
    gap: var(--space-3);
    padding-block: 0.7rem;
  }

  .ticket-fields li::before {
    content: counter(field);
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--accent-primary-soft);
    color: var(--accent-primary);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .ticket-fields li::after {
    content: '';
    flex: 1;
    min-width: 2rem;
    border-bottom: 1.5px dotted var(--border-soft);
    margin-bottom: 0.4rem;
  }

  .ticket-foot {
    margin: var(--space-4) 0 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--accent-primary);
  }

  @media (max-width: 52rem) {
    .order-grid {
      grid-template-columns: 1fr;
    }

    .ticket {
      rotate: 0deg;
      padding-inline: var(--space-5);
    }
  }
</style>
