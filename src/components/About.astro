---
import { Image } from 'astro:assets';
import brideCake from '../assets/images/cake_6.jpg';
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="container about-grid">
    <figure class="about-photo" data-reveal>
      <Image
        src={brideCake}
        alt="Bride to Be cake with an illustrated bride in gold jewellery, a red rose and sunflowers"
        widths={[420, 640, 860]}
        sizes="(max-width: 52rem) 90vw, 30rem"
      />
    </figure>

    <div class="about-copy" data-reveal>
      <p class="eyebrow">About Dillz Bites</p>
      <h2 class="section-title" id="about-title">A small kitchen with a big eye for detail.</h2>
      <p class="section-intro">
        Dillz Bites is a small, independent bakery making custom cakes for the moments people remember. Every
        order is handmade in small batches with good ingredients, careful flavour pairing and finishing touches
        you'll want to photograph before anyone cuts in.
      </p>
      <p class="section-intro">
        We start with your event, not a catalogue. Design, size and decoration are shaped around your theme,
        your guest list and your budget, so the cake feels like it belongs at your party and nowhere else.
      </p>

      <dl class="about-facts">
        <div>
          <dt>Made to order</dt>
          <dd>Nothing pre-made, nothing off the shelf.</dd>
        </div>
        <div>
          <dt>Design first</dt>
          <dd>Colours, toppers and motifs chosen for your event.</dd>
        </div>
        <div>
          <dt>Straight answers</dt>
          <dd>Quotes, updates and confirmations right in WhatsApp.</dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: center;
  }

  .about-photo {
    margin: 0;
    border-radius: var(--radius-arch);
    overflow: clip;
    box-shadow: var(--shadow-lg);
  }

  .about-photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .about-facts {
    margin: var(--space-7) 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .about-facts div {
    padding-top: var(--space-4);
    border-top: 3px solid var(--accent-secondary);
  }

  .about-facts dt {
    font-family: var(--font-display);
    font-size: 1.25rem;
  }

  .about-facts dd {
    margin: var(--space-2) 0 0;
    color: var(--text-muted);
    font-size: 0.97rem;
  }

  @media (max-width: 52rem) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .about-photo {
      max-width: 26rem;
    }
  }

  @media (max-width: 40rem) {
    .about-facts {
      grid-template-columns: 1fr;
    }
  }
</style>
